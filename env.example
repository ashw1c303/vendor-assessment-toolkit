# Copy to .env.local. Do not commit .env or .env.local.

# Slack app tokens. Mint them with:
#   npx bdk slack create --dir . --name "Vendor Onboarding" --prefix VENDOR_ONBOARDING
# Local serve and the playground work without these. The Slack channel idles until they exist.
VENDOR_ONBOARDING_SLACK_BOT_TOKEN=
VENDOR_ONBOARDING_SLACK_APP_TOKEN=

# Optional Slack channel for the Monday leadership summary (C… id or #name).
VENDOR_ONBOARDING_EXEC_SLACK_CHANNEL=

# Research MCP. Firecrawl is the connection in bot/mcp-connections/research.ts.
FIRECRAWL_API_KEY=

# Used only if you point that connection at Exa instead. See the comment in research.ts.
EXA_API_KEY=

# MongoDB Atlas — durable vendor stage tracker (bot/lib/vendor-store.ts).
# host.kv remains the fast local session cache. When MONGODB_URI is unset,
# tools still succeed and return atlas: { ok:false, error:"mongodb_uri_unset" }.
# Atlas MCP for Cursor/Grok: bot/mcp-connections/atlas.ts reads the same URI
# via MDB_MCP_CONNECTION_STRING=${MONGODB_URI}.
MONGODB_URI=
# Database and collection names (defaults shown).
MONGODB_DB=vendor_onboarding
MONGODB_COLLECTION=vendor_requests
# Set to 1 for in-process mock Atlas (CI / local smoke without a cluster).
MONGODB_MOCK=
